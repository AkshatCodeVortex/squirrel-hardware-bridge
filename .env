# ─────────────────────────────────────────────────────────────────────────────
# FINGERPRINT_MODE — controls which fingerprint provider the bridge uses
#
#   mock           → MockFingerprintProvider (use on Mac / any dev machine)
#                    No hardware required. Full POS + Admin + Backend testing.
#
#   hikvision_usb  → HikvisionUsbFingerprintProvider (use on Windows production)
#                    Requires: FPModule_SDK_x64.dll in sdk/lib/
#                    Requires: DS-K1F820-F USB scanner connected
#                    Before first use: npm run fingerprint:diagnose
#
# DO NOT set to hikvision_usb on Mac — it will error immediately (correct behaviour).
# ─────────────────────────────────────────────────────────────────────────────
FINGERPRINT_MODE=mock
#FINGERPRINT_MODE=hikvision_usb


