# ============================================================
# Squirrel Hardware Bridge - Production Configuration
# ============================================================
# Copy this file to config\.env and fill in your values.
# This file is installed by the setup wizard.
# DO NOT commit production secrets to Git.
# ============================================================

# ── Bridge Network ─────────────────────────────────────────
# Port the WebSocket server listens on (POS must match)
HARDWARE_BRIDGE_PORT=8765

# ── Backend API ────────────────────────────────────────────
# Your Qkarts cloud backend URL
BACKEND_API=https://api.qkarts.com/api

# ── Terminal Authentication ────────────────────────────────
# Generate from: Qkarts Admin → Settings → Terminal Tokens
# This token identifies which outlet this terminal belongs to.
TERMINAL_TOKEN=

# ── Fingerprint Mode ───────────────────────────────────────
# hikvision_usb → real DS-K1F820-F scanner (Windows production)
# mock          → software simulation (Mac/dev only)
FINGERPRINT_MODE=hikvision_usb
